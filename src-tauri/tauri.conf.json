{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyChecklist",
  "version": "0.1.0",
  "identifier": "net.wefaber.mychecklist",
  "build": {
    "beforeDevCommand": "bun run dev:web",
    "devUrl": "http://localhost:5191",
    "beforeBuildCommand": "bun run build:web",
    "frontendDist": "../dist/web"
  },
  "app": {
    "windows": [
      {
        "title": "MyChecklist",
        "width": 1100,
        "height": 760,
        "minWidth": 480,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
